# ===================
# DATABASE
# ===================
DATABASE_URL=postgresql://user:password@localhost:5432/paygw

# ===================
# SERVER
# ===================
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# ===================
# JWT SECRETS
# Generate: openssl rand -hex 32
# ===================
JWT_SECRET=replace-with-64-char-random-hex
JWT_REFRESH_SECRET=replace-with-64-char-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ===================
# WEBHOOK
# ===================
WEBHOOK_SECRET=replace-with-64-char-random-hex

# ===================
# PAYMENT PROVIDER
# ===================
PAYMENT_PROVIDER=manual
PAYMENT_PROVIDER_API_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_SECRET=

# ===================
# FIREBASE (Android Push)
# ===================
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ===================
# SUPER ADMIN
# ===================
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
